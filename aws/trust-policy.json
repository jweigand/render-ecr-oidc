{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::<AWS_ACCOUNT_ID>:oidc-provider/oidc.render.com/<WORKSPACE_ID>"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "oidc.render.com/<WORKSPACE_ID>:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "oidc.render.com/<WORKSPACE_ID>:sub": "*<CRON_SERVICE_ID>*"
        }
      }
    }
  ]
}
